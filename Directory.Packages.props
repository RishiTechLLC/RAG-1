<Project>
  <!-- Central package management: every project pulls its versions from here. -->
  <PropertyGroup>
    <!-- Lets the pins below override vulnerable transitive versions. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Azure SDKs -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />

    <!-- AI: OpenAI SDK (talks to Azure OpenAI v1 endpoint), Microsoft.Extensions.AI, Agent Framework, MCP -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!-- Document parsing -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- Data -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <!-- Pinned above the vulnerable 9.0.x version that Microsoft.Data.SqlClient pulls in transitively. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Pinned above the vulnerable version pulled in by the Aspire hosting packages. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />

    <!-- Hosting / observability -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />

    <!-- Aspire (local orchestration) -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
