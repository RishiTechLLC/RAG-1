{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/config.json", "/*.{js,css,ico,png,svg,json}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/config.json", "headers": { "Cache-Control": "no-store" } }
  ]
}
